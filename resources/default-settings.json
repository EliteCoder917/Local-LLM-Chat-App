{
  "settings": {
    "theme": "dark",
    "model": "llama3.1:8b",
    "engine": "ollama",
    "modelPath": "",
    "ollamaUrl": "http://127.0.0.1:11434",
    "workspace": "",
    "agentMode": true,
    "maxIterations": 10,
    "temperature": 0.7,
